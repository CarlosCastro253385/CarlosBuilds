---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// ID del video de YouTube: lo que va después de "v=" en el enlace.
// Ejemplo: en https://www.youtube.com/watch?v=abc123XYZ el ID es abc123XYZ
// Vacío = se muestra "Video próximamente".
const VIDEO_ID = '';

const landing = await getEntry('landing', 'index');
const email = landing?.data.contacto_email ?? 'cruzcastro4@gmail.com';
const githubUrl = landing?.data.github_url ?? 'https://github.com/CarlosCastro253385/';

// Solo lo que ya funciona hoy
const disponibles = [
  {
    icono: '✍️',
    titulo: 'Vista previa en vivo',
    texto: 'Mira cómo se verá tu entrada mientras la escribes, con el mismo estilo de tu sitio.',
  },
  {
    icono: '🧩',
    titulo: 'Plantillas',
    texto: 'Cada tipo de entrada empieza con su estructura lista. Solo llenas los espacios.',
  },
  {
    icono: '📈',
    titulo: 'Métricas sin cookies',
    texto: 'Visitas por periodo, variación contra el periodo anterior, gráficas y exportación a CSV.',
  },
  {
    icono: '📱',
    titulo: 'Instalable como app',
    texto: 'Ábrelo desde un icono en tu celular, como cualquier otra aplicación.',
  },
  {
    icono: '🌙',
    titulo: 'Modo claro y oscuro',
    texto: 'Cambia entre los dos con un botón.',
  },
  {
    icono: '🔓',
    titulo: 'Tu contenido es tuyo',
    texto: 'Todo se guarda en tu propio repositorio de GitHub, sin una base de datos que dependa de nadie más.',
  },
];

// Lo que todavía no existe
const proximamente = [
  { titulo: 'Varios sitios', texto: 'Conectar más de un sitio al mismo panel y cambiar entre ellos.' },
  { titulo: 'Borradores', texto: 'Guardar una entrada sin publicarla todavía.' },
  { titulo: 'Fotos con compresión', texto: 'Subir imágenes que se optimizan solas.' },
];

const pasos = [
  { titulo: 'Entra con GitHub', texto: 'Inicias sesión con tu cuenta. No hay otra contraseña que recordar.' },
  { titulo: 'Escribe con una plantilla', texto: 'Eliges el tipo de entrada y ya tienes la estructura armada.' },
  { titulo: 'Mira cómo queda', texto: 'La vista previa se actualiza mientras escribes.' },
  { titulo: 'Publica y mide', texto: 'Con un clic se publica, y el tablero te muestra cuánta gente la leyó.' },
];

const preguntas = [
  {
    p: '¿Es gratis?',
    r: 'Sí. Funciona sobre servicios que tienen plan gratuito: GitHub, Vercel y GoatCounter.',
  },
  {
    p: '¿Dónde se guarda mi contenido?',
    r: 'En tu repositorio de GitHub. Cada vez que publicas se guarda un cambio ahí y tu sitio se actualiza solo.',
  },
  {
    p: '¿Necesito saber programar?',
    r: 'Para escribir y publicar, no. Conectar un sitio nuevo todavía requiere ayuda, porque el proyecto está en pruebas.',
  },
  {
    p: '¿Usa cookies?',
    r: 'No. El panel guarda tu sesión en tu navegador, y las visitas se cuentan con GoatCounter, que no usa cookies.',
  },
  {
    p: '¿Puedo usarlo ya?',
    r: 'Todavía no está abierto al público. Hoy funciona con el sitio de su creador, y abrirlo a más personas está en el plan.',
  },
];
---

<BaseLayout
  title="Bitácora CMS — Escribe, mira cómo queda, publica"
  description="Bitácora es un panel para escribir, previsualizar y publicar tu blog sin tocar código. Con métricas sin cookies y tu contenido en tu propio GitHub."
  bodyClass="bitacora"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </Fragment>

  <a href="#contenido" class="salto">Saltar al contenido</a>

  <header class="encabezado">
    <div class="encabezado-in">
      <a href="/bitacora" class="marca"><span aria-hidden="true">&gt;_</span> Bitácora</a>
      <nav aria-label="Principal" class="encabezado-links">
        <a href="#preguntas">Preguntas</a>
        <a href="/">Mi sitio</a>
      </nav>
    </div>
  </header>

  <main id="contenido">

    <!-- PORTADA -->
    <section class="portada">
      <div class="portada-texto">
        <p class="etiqueta">// cms en pruebas</p>
        <h1>Bitácora <span class="degradado">CMS</span></h1>
        <p class="lema">Escribe, mira cómo queda, publica.</p>
        <p class="bajada">
          Un panel para llevar tu blog sin tocar código, con métricas que no usan cookies y tu
          contenido guardado en tu propio GitHub.
        </p>
        <div class="botones">
          <a href="#video" class="btn btn-principal">▶ Ver el video</a>
          <a href="#que-hace" class="btn">Qué puedes hacer</a>
        </div>
      </div>

      <figure class="ventana">
        <div class="ventana-barra" aria-hidden="true"><span></span><span></span><span></span></div>
        <pre class="ventana-cuerpo"><code>## El problema
Describe qué pasaba y copia
el mensaje de error exacto.

## Qué intenté
- 

## La solución
Explica el arreglo paso a paso.

## Por qué funciona

## Para no repetirlo</code></pre>
        <figcaption>Así empieza una entrada nueva en «Problemas resueltos».</figcaption>
      </figure>
    </section>

    <!-- QUÉ HACE -->
    <section id="que-hace" class="seccion" aria-labelledby="t-hace">
      <h2 id="t-hace" class="titulo">Qué puedes hacer hoy</h2>
      <div class="rejilla">
        {disponibles.map((c) => (
          <article class="tarjeta">
            <span class="icono" aria-hidden="true">{c.icono}</span>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
          </article>
        ))}
      </div>

      <h3 class="subtitulo">Próximamente</h3>
      <ul class="proximo">
        {proximamente.map((c) => (
          <li>
            <strong>{c.titulo}</strong>
            <span>{c.texto}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section id="como-funciona" class="seccion" aria-labelledby="t-como">
      <h2 id="t-como" class="titulo">Cómo funciona</h2>
      <ol class="pasos">
        {pasos.map((p) => (
          <li>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- VIDEO -->
    <section id="video" class="seccion" aria-labelledby="t-video">
      <h2 id="t-video" class="titulo">Míralo en acción</h2>
      <div class="video-caja">
        {VIDEO_ID ? (
          <button type="button" class="video-boton" data-video-id={VIDEO_ID}>
            <span class="video-play" aria-hidden="true">▶</span>
            <span>Reproducir el video</span>
            <small>Se carga solo cuando le das clic.</small>
          </button>
        ) : (
          <p class="video-pendiente">Video próximamente</p>
        )}
      </div>
    </section>

    <!-- PREGUNTAS -->
    <section id="preguntas" class="seccion" aria-labelledby="t-preguntas">
      <h2 id="t-preguntas" class="titulo">Preguntas frecuentes</h2>
      <div class="faq">
        {preguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CONTACTO -->
    <section class="seccion cierre" aria-labelledby="t-cierre">
      <h2 id="t-cierre" class="titulo">¿Quieres probarlo cuando se abra?</h2>
      <p class="bajada">Escríbeme y te aviso en cuanto esté listo.</p>
      <div class="botones centrado">
        <a class="btn btn-principal" href={`mailto:${email}?subject=Bit%C3%A1cora%20CMS`}>Escribirme</a>
        <a class="btn" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </section>
  </main>

  <footer class="pie">
    <nav aria-label="Enlaces del sitio" class="pie-links">
      <a href="/">Mi página principal</a>
      <a href="/blog">Blog</a>
    </nav>
    <p>
      Proyecto en fase de pruebas · Hecho por Carlos Castro ·
      Construido sobre Decap CMS, Astro, Vercel y GoatCounter.
    </p>
  </footer>

  <script is:inline>
    // El video de YouTube solo se carga cuando la persona le da clic
    document.querySelectorAll('[data-video-id]').forEach(function (boton) {
      boton.addEventListener('click', function () {
        var id = boton.getAttribute('data-video-id');
        var marco = document.createElement('iframe');
        marco.src =
          'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0';
        marco.title = 'Video de presentación de Bitácora CMS';
        marco.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        marco.allowFullscreen = true;
        marco.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
        boton.replaceWith(marco);
      });
    });
  </script>
</BaseLayout>

<style is:global>
  body.bitacora {
    --bg: #0a0b10;
    --card: rgba(18, 22, 36, 0.75);
    --borde: rgba(147, 112, 219, 0.25);
    --texto: #e2e8f0;
    --suave: #94a3b8;
    --cian: #00f2fe;
    --morado: #7928ca;
    --rosa: #ff5aa8;
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;

    margin: 0;
    background-color: var(--bg);
    background-image:
      radial-gradient(circle at 15% 15%, rgba(121, 40, 202, 0.18) 0%, transparent 40%),
      radial-gradient(circle at 85% 60%, rgba(0, 242, 254, 0.1) 0%, transparent 40%),
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 32px 32px, 32px 32px;
    color: var(--texto);
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
    overflow-x: clip;
  }

  body.bitacora *,
  body.bitacora *::before,
  body.bitacora *::after {
    box-sizing: border-box;
  }

  body.bitacora h1,
  body.bitacora h2,
  body.bitacora h3,
  body.bitacora p,
  body.bitacora ul,
  body.bitacora ol,
  body.bitacora figure {
    margin: 0;
    padding: 0;
  }

  body.bitacora ul,
  body.bitacora ol {
    list-style: none;
  }

  body.bitacora a:focus-visible,
  body.bitacora button:focus-visible,
  body.bitacora summary:focus-visible {
    outline: 2px solid var(--cian);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    html:has(body.bitacora) {
      scroll-behavior: smooth;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body.bitacora *,
    body.bitacora *::before,
    body.bitacora *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<style>
  .salto {
    position: absolute;
    left: 12px;
    top: -64px;
    z-index: 200;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--cian);
    color: #04111a;
    font-weight: 700;
    text-decoration: none;
  }

  .salto:focus-visible {
    top: 12px;
  }

  /* ----- Encabezado ----- */
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--borde);
    background: rgba(10, 11, 16, 0.85);
    backdrop-filter: blur(12px);
  }

  .encabezado-in {
    max-width: 1100px;
    margin: 0 auto;
    padding: 6px 20px;
    min-height: 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .marca {
    font-family: var(--mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
  }

  .marca span {
    color: var(--cian);
  }

  .encabezado-links {
    display: flex;
    gap: 4px;
  }

  .encabezado-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--suave);
    text-decoration: none;
  }

  .encabezado-links a:hover {
    color: var(--cian);
  }

  /* ----- Secciones ----- */
  main > section {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(44px, 8vw, 84px) 20px;
    scroll-margin-top: 64px;
  }

  .titulo {
    margin-bottom: 28px;
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    line-height: 1.2;
    color: #fff;
  }

  .subtitulo {
    margin: 36px 0 14px;
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--rosa);
  }

  .etiqueta {
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--cian);
  }

  /* ----- Portada ----- */
  .portada {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 48px;
  }

  h1 {
    margin-bottom: 14px;
    font-size: clamp(2.6rem, 8vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .degradado {
    color: var(--cian);
    background: linear-gradient(135deg, var(--cian), var(--morado));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lema {
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: clamp(1rem, 3vw, 1.25rem);
    color: #fff;
  }

  .bajada {
    max-width: 56ch;
    margin-bottom: 28px;
    font-size: 1.05rem;
    color: var(--suave);
  }

  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .botones.centrado {
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: var(--card);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .btn:hover {
    border-color: var(--cian);
    color: var(--cian);
    transform: translateY(-2px);
  }

  .btn-principal {
    border-color: transparent;
    background: linear-gradient(135deg, var(--cian), #4facfe);
    color: #04111a;
  }

  .btn-principal:hover {
    color: #04111a;
    box-shadow: 0 0 24px rgba(0, 242, 254, 0.35);
  }

  /* Ventana de ejemplo */
  .ventana {
    border: 1px solid var(--borde);
    border-radius: 14px;
    background: #0b1120;
    overflow: hidden;
    box-shadow: 0 0 40px rgba(121, 40, 202, 0.25);
  }

  .ventana-barra {
    display: flex;
    gap: 7px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--borde);
    background: rgba(255, 255, 255, 0.03);
  }

  .ventana-barra span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .ventana-barra span:nth-child(1) {
    background: #ef4444;
  }

  .ventana-barra span:nth-child(2) {
    background: #f59e0b;
  }

  .ventana-barra span:nth-child(3) {
    background: #22c55e;
  }

  .ventana-cuerpo {
    margin: 0;
    padding: 18px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: #cbd5e1;
  }

  .ventana figcaption {
    padding: 10px 18px 14px;
    font-size: 0.8rem;
    color: var(--suave);
  }

  /* ----- Tarjetas ----- */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 18px;
  }

  .tarjeta {
    padding: 22px;
    border: 1px solid var(--borde);
    border-radius: 14px;
    background: var(--card);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .tarjeta:hover {
    border-color: rgba(0, 242, 254, 0.5);
    transform: translateY(-3px);
  }

  .icono {
    display: block;
    margin-bottom: 10px;
    font-size: 1.6rem;
  }

  .tarjeta h3 {
    margin-bottom: 6px;
    font-size: 1.1rem;
    color: #fff;
  }

  .tarjeta p {
    font-size: 0.95rem;
    color: var(--suave);
  }

  .proximo {
    display: grid;
    gap: 10px;
  }

  .proximo li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px;
    border: 1px dashed var(--borde);
    border-radius: 12px;
  }

  .proximo strong {
    color: #fff;
  }

  .proximo span {
    font-size: 0.92rem;
    color: var(--suave);
  }

  /* ----- Pasos ----- */
  .pasos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 18px;
    counter-reset: paso;
  }

  .pasos li {
    position: relative;
    padding: 56px 20px 22px;
    border: 1px solid var(--borde);
    border-radius: 14px;
    background: var(--card);
    counter-increment: paso;
  }

  .pasos li::before {
    content: counter(paso);
    position: absolute;
    top: 16px;
    left: 20px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--cian), var(--morado));
    font-family: var(--mono);
    font-weight: 700;
    color: #04111a;
  }

  .pasos h3 {
    margin-bottom: 6px;
    font-size: 1.05rem;
    color: #fff;
  }

  .pasos p {
    font-size: 0.92rem;
    color: var(--suave);
  }

  /* ----- Video ----- */
  .video-caja {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 880px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: 14px;
    background: #0b1120;
  }

  .video-boton {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    background: radial-gradient(circle at 50% 40%, rgba(121, 40, 202, 0.35), transparent 60%), #0b1120;
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .video-boton small {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--suave);
  }

  .video-play {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--cian), #4facfe);
    font-size: 1.6rem;
    color: #04111a;
    padding-left: 4px;
  }

  .video-pendiente {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    color: var(--suave);
  }

  /* ----- Preguntas ----- */
  .faq {
    display: grid;
    gap: 12px;
    max-width: 820px;
  }

  .faq details {
    border: 1px solid var(--borde);
    border-radius: 12px;
    background: var(--card);
  }

  .faq summary {
    padding: 16px 20px;
    min-height: 48px;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
  }

  .faq details p {
    padding: 0 20px 18px;
    color: var(--suave);
  }

  /* ----- Cierre y pie ----- */
  .cierre {
    text-align: center;
  }

  .cierre .bajada {
    margin-left: auto;
    margin-right: auto;
  }

  .pie {
    padding: 28px 20px 36px;
    border-top: 1px solid var(--borde);
    text-align: center;
    font-size: 0.85rem;
    color: var(--suave);
  }

  .pie-links {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 10px;
  }

  .pie-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--mono);
    color: var(--cian);
    text-decoration: none;
  }

  .pie-links a:hover {
    text-decoration: underline;
  }

  /* ----- Celular ----- */
  @media (max-width: 820px) {
    .portada {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .botones .btn {
      flex: 1 1 100%;
    }
  }
</style>