---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CarlosBuilds — Mini proyectos y problemas reales</title>
  
  <!-- Fuentes Google: JetBrains Mono (estilo terminal) e Inter (lectura limpia) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN para estilos rápidos -->
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              bg: '#050810',       /* Fondo azul profundo ultra oscuro */
              card: '#0b1120',     /* Color de las tarjetas */
              border: '#1e293b',   /* Color de los bordes */
              cyan: '#00f2fe',     /* Color cian neón de acento */
              text: '#94a3b8',     /* Texto secundario */
              heading: '#f8fafc'   /* Texto principal brillante */
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Fondo con cuadrícula técnica sutil */
    body {
      background-color: #050810;
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(0, 242, 254, 0.08) 0%, transparent 60%),
        linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
      background-size: 100% 100%, 32px 32px, 32px 32px;
    }

    /* Animación del cursor titilante */
    .blink-cursor {
      animation: blink 1s step-start infinite;
    }
    @keyframes blink {
      50% { opacity: 0; }
    }
  </style>
</head>

<body class="font-sans text-brand-text min-h-screen antialiased selection:bg-brand-cyan selection:text-black">

  <!-- ==================== ENCABEZADO (SIN MENÚS) ==================== -->
  <header class="border-b border-brand-border/60 bg-brand-bg/80 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between text-sm">
      
      <!-- BRANDING / NOMBRE -->
      <a href="#" class="font-mono text-brand-heading hover:text-brand-cyan transition-colors flex items-center gap-2">
        <span class="text-brand-cyan">&gt;</span> CarlosBuilds<span class="inline-block w-2 h-4 bg-brand-cyan blink-cursor"></span>
      </a>

      <!-- INDICADOR DISPONIBLE -->
      <div class="flex items-center gap-2 font-mono text-xs text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-2.5 py-1 rounded-full">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Disponible para proyectos
      </div>

    </div>
  </header>

  <!-- ==================== CONTENIDO PRINCIPAL ==================== -->
  <main class="max-w-6xl mx-auto px-4 py-12">

    <!-- HERO SECTION -->
    <section class="mb-12">
      <div class="font-mono text-xs text-brand-cyan mb-3 flex items-center gap-2">
        <span>~ / CarlosBuilds / blog</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-bold text-brand-heading tracking-tight mb-4 max-w-2xl leading-tight">
        Mini proyectos, <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan to-blue-500">problemas reales</span> y lo que aprendí.
      </h1>

      <p class="text-brand-text max-w-2xl text-base mb-6 leading-relaxed">
        Escribo sobre lo que construyo y lo que rompo. Backend, herramientas de línea de comandos, bases de datos y los errores que nadie documenta bien.
      </p>

      <!-- DATOS DINÁMICOS -->
      <div class="font-mono text-xs text-slate-500 flex items-center gap-4">
        <span><strong id="total-posts-count" class="text-brand-heading">0</strong> posts publicados</span>
        <span>•</span>
        <span><strong id="total-views-count" class="text-brand-heading">0</strong> lecturas totales</span>
      </div>
    </section>

    <!-- GRID PRINCIPAL (ARTÍCULOS + LATERAL) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

      <!-- COLUMNA IZQUIERDA: FILTROS Y LISTA DE ARTÍCULOS (8 COLS) -->
      <div class="lg:col-span-8">

        <!-- FILTROS POR CATEGORÍA -->
        <div class="flex flex-wrap gap-2 mb-8 font-mono text-xs" id="filter-buttons">
          <button data-filter="TODOS" class="filter-btn active bg-brand-cyan text-black px-3 py-1.5 rounded font-semibold transition-all">
            TODOS
          </button>
          <button data-filter="MINI-PROYECTO" class="filter-btn bg-brand-card text-brand-text border border-brand-border hover:border-slate-500 px-3 py-1.5 rounded transition-all">
            MINI-PROYECTO
          </button>
          <button data-filter="PROBLEMA-RESUELTO" class="filter-btn bg-brand-card text-brand-text border border-brand-border hover:border-slate-500 px-3 py-1.5 rounded transition-all">
            PROBLEMA-RESUELTO
          </button>
        </div>

        <!-- CONTENEDOR DE TARJETAS -->
        <div class="space-y-4" id="posts-container">
          <!-- Se renderizan dinámicamente con JavaScript -->
        </div>

      </div>

      <!-- COLUMNA DERECHA: SIDEBAR (4 COLS) -->
      <aside class="lg:col-span-4 space-y-6">

        <!-- WIDGET 1: SOBRE MÍ -->
        <div class="bg-brand-card border border-brand-border/80 rounded-lg p-5">
          <div class="font-mono text-xs text-brand-cyan mb-2">// SOBRE MI</div>
          <p class="text-xs text-brand-text leading-relaxed mb-4">
            Hola, soy Carlos. Construyo proyectos web y de backend para entender cosas grandes. Todo lo que aprendo y resuelvo, lo escribo aquí.
          </p>
          <div class="font-mono text-xs flex gap-4 text-brand-cyan">
            <a href="https://github.com/CarlosCastro253385/" target="_blank" class="hover:underline">GitHub</a>
            <a href="https://www.instagram.com/slrc_ttr/" target="_blank" class="hover:underline">Instagram</a>
          </div>
        </div>

        <!-- WIDGET 2: TAGS -->
        <div class="bg-brand-card border border-brand-border/80 rounded-lg p-5">
          <div class="font-mono text-xs text-brand-cyan mb-3">// TAGS</div>
          <div class="flex flex-wrap gap-1.5 font-mono text-[11px]" id="tags-container">
            <!-- Se renderizan automáticamente -->
          </div>
        </div>

        <!-- WIDGET 3: STATS AUTOMÁTICAS -->
        <div class="bg-brand-card border border-brand-border/80 rounded-lg p-5 font-mono text-xs space-y-2">
          <div class="text-brand-cyan mb-3">// STATS</div>
          <div class="flex justify-between text-slate-400">
            <span>mini-proyectos</span>
            <span id="stat-mini-projects" class="text-brand-cyan font-bold">0</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>problemas resueltos</span>
            <span id="stat-problems-solved" class="text-brand-cyan font-bold">0</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>tags distintos</span>
            <span id="stat-tags-count" class="text-brand-cyan font-bold">0</span>
          </div>
        </div>

      </aside>

    </div>

  </main>

  <!-- ==================== FOOTER ==================== -->
  <footer class="border-t border-brand-border/60 mt-20 py-8 text-center font-mono text-xs text-slate-600">
    <p>© 2026 CarlosBuilds · El hombre aprende mientras vive · sin cookies, sin trackers</p>
  </footer>


  <!-- ==================== JAVASCRIPT (LÓGICA Y DATOS) ==================== -->
  <script>
    // DATOS DE LOS ARTÍCULOS
    // DATOS DE LOS ARTÍCULOS
    const posts = [
      {
        id: 1,
        title: "Cómo subir tu proyecto a GitHub desde la terminal de VS Code",
        excerpt: "Guía paso a paso usando los comandos esenciales (git init, git add, git commit y git push) para publicar tu código sin instalar programas extra.",
        category: "PROBLEMA-RESUELTO",
        views: 1,
        date: "20 sep 2026",
        readTime: "3 min",
        tags: ["git", "github", "vscode"]
      },
      {
        id: 2,
        title: "Cómo enlazar HTML, CSS y JavaScript sin cometer errores de ruta",
        excerpt: "Explicación sencilla de cómo funciona el tag <link> y el tag <script>, y cómo organizar tus carpetas para que tus estilos y funciones siempre carguen.",
        category: "PROBLEMA-RESUELTO",
        views: 1,
        date: "19 sep 2026",
        readTime: "4 min",
        tags: ["html", "css", "javascript"]
      },
      {
        id: 3,
        title: "Uso del archivo .gitignore: Evita subir carpetas pesadas a GitHub",
        excerpt: "Aprende a configurar tu archivo .gitignore para omitir archivos secretos (.env) o carpetas gigantes (node_modules) antes de hacer commit.",
        category: "PROBLEMA-RESUELTO",
        views: 1,
        date: "18 sep 2026",
        readTime: "3 min",
        tags: ["git", "github", "consejos"]
      },
      {
        id: 4,
        title: "Las 5 extensiones esenciales de VS Code para desarrollo web",
        excerpt: "Optimiza tu editor con Live Server, Tailwind CSS IntelliSense, Auto Rename Tag, Prettier y GitLens para programar el doble de rápido.",
        category: "MINI-PROYECTO",
        views: 1,
        date: "15 sep 2026",
        readTime: "5 min",
        tags: ["vscode", "herramientas", "web"]
      },
      {
        id: 5,
        title: "Cómo desplegar tu web estática gratis en Vercel en menos de 2 minutos",
        excerpt: "El flujo continuo definitivo: conecta tu repositorio de GitHub con Vercel para publicar tus proyectos web con certificado SSL automático.",
        category: "MINI-PROYECTO",
        views: 1,
        date: "10 sep 2026",
        readTime: "4 min",
        tags: ["vercel", "github", "hosting"]
      }
    ];

    let currentFilter = 'TODOS';
    let selectedTag = null;

    // RENDERIZAR ARTÍCULOS
    function renderPosts() {
      const container = document.getElementById('posts-container');
      container.innerHTML = '';

      const filteredPosts = posts.filter(post => {
        const matchesCategory = currentFilter === 'TODOS' || post.category === currentFilter;
        const matchesTag = selectedTag === null || post.tags.includes(selectedTag);
        return matchesCategory && matchesTag;
      });

      if (filteredPosts.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 border border-dashed border-brand-border rounded-lg font-mono text-xs text-slate-500">
            No se encontraron artículos para esta combinación.
          </div>`;
        return;
      }

      filteredPosts.forEach(post => {
        const card = document.createElement('article');
        card.className = "bg-brand-card border border-brand-border/80 hover:border-brand-cyan/50 rounded-lg p-6 transition-all duration-200 group";
        card.innerHTML = `
          <div class="flex justify-between items-center font-mono text-xs mb-3">
            <span class="bg-brand-cyan/10 text-brand-cyan border border-brand-cyan/30 px-2 py-0.5 rounded font-semibold">
              ${post.category}
            </span>
            <span class="text-slate-500">${post.views.toLocaleString()} views</span>
          </div>

          <h2 class="text-lg font-bold text-brand-heading group-hover:text-brand-cyan transition-colors mb-2">
            <a href="#">${post.title}</a>
          </h2>

          <p class="text-xs text-brand-text leading-relaxed mb-4">
            ${post.excerpt}
          </p>

          <div class="flex flex-wrap justify-between items-center font-mono text-[11px] text-slate-500 pt-3 border-t border-brand-border/40">
            <div class="flex gap-2">
              ${post.tags.map(t => `<span class="bg-slate-900 border border-slate-800 text-slate-400 px-2 py-0.5 rounded">#${t}</span>`).join('')}
            </div>
            <div>
              <span>${post.date}</span> • <span>${post.readTime}</span>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // CALCULAR Y MOSTRAR ESTADÍSTICAS AUTOMÁTICAS
    function updateStats() {
      const totalPosts = posts.length;
      const totalViews = posts.reduce((sum, p) => sum + p.views, 0);
      const miniProjects = posts.filter(p => p.category === 'MINI-PROYECTO').length;
      const problemsSolved = posts.filter(p => p.category === 'PROBLEMA-RESUELTO').length;
      
      const allTags = new Set();
      posts.forEach(p => p.tags.forEach(t => allTags.add(t)));

      document.getElementById('total-posts-count').innerText = totalPosts;
      document.getElementById('total-views-count').innerText = totalViews.toLocaleString();
      document.getElementById('stat-mini-projects').innerText = miniProjects;
      document.getElementById('stat-problems-solved').innerText = problemsSolved;
      document.getElementById('stat-tags-count').innerText = allTags.size;

      // Renderizar tags en sidebar
      const tagsContainer = document.getElementById('tags-container');
      tagsContainer.innerHTML = '';
      allTags.forEach(tag => {
        const tagBtn = document.createElement('button');
        tagBtn.className = `px-2 py-1 rounded border transition-all ${selectedTag === tag ? 'bg-brand-cyan text-black border-brand-cyan font-bold' : 'bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-600'}`;
        tagBtn.innerText = `#${tag}`;
        tagBtn.onclick = () => {
          selectedTag = selectedTag === tag ? null : tag;
          updateStats();
          renderPosts();
        };
        tagsContainer.appendChild(tagBtn);
      });
    }

    // EVENTOS DE BOTONES DE FILTRO
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.filter-btn').forEach(b => {
          b.className = "filter-btn bg-brand-card text-brand-text border border-brand-border hover:border-slate-500 px-3 py-1.5 rounded transition-all font-mono text-xs";
        });
        e.target.className = "filter-btn active bg-brand-cyan text-black px-3 py-1.5 rounded font-semibold transition-all font-mono text-xs";
        currentFilter = e.target.getAttribute('data-filter');
        renderPosts();
      });
    });

    // INICIALIZACIÓN
    updateStats();
    renderPosts();
  </script>

</body>
</html>