---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Todas las entradas, de la más reciente a la más antigua
const todas = (await getCollection('blog')).sort((a, b) =>
  String(b.data.date).localeCompare(String(a.data.date))
);
const indice = todas.findIndex((p) => p.slug === entry.slug);
const masReciente = indice > 0 ? todas[indice - 1] : undefined;
const masAntigua = indice >= 0 && indice < todas.length - 1 ? todas[indice + 1] : undefined;

// Relacionadas: comparten al menos una etiqueta
const misEtiquetas = new Set(entry.data.tags || []);
const relacionadas = todas
  .filter((p) => p.slug !== entry.slug)
  .map((p) => ({
    post: p,
    comunes: (p.data.tags || []).filter((t) => misEtiquetas.has(t)).length,
  }))
  .filter((r) => r.comunes > 0)
  .sort((a, b) => b.comunes - a.comunes)
  .slice(0, 3)
  .map((r) => r.post);

// Tiempo de lectura (unas 200 palabras por minuto)
const palabras = (entry.body || '').split(/\s+/).filter(Boolean).length;
const minutos = Math.max(1, Math.ceil(palabras / 200));

// Índice: solo títulos de nivel 2 y 3
const titulos = headings.filter((h) => h.depth === 2 || h.depth === 3);

const fechaLegible = (texto: string) => {
  const f = new Date(`${texto}T12:00:00`);
  return Number.isNaN(f.getTime())
    ? texto
    : f.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
};
---

<BaseLayout
  title={`${entry.data.title} — CarlosBuilds`}
  description={entry.data.summary}
  htmlClass="dark"
  bodyClass="font-sans text-slate-400 min-h-screen antialiased selection:bg-cyan-400 selection:text-black"
  type="article"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </Fragment>

  <!-- BARRA DE PROGRESO DE LECTURA -->
  <div
    id="progreso"
    class="fixed top-0 left-0 z-[60] h-0.5 w-full origin-left bg-gradient-to-r from-cyan-400 to-blue-500"
    style="transform: scaleX(0)"
    aria-hidden="true"
  ></div>

  <!-- ENCABEZADO -->
  <header class="border-b border-slate-800/60 bg-[#050810]/80 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between text-sm">
      <a href="/" class="font-mono text-slate-100 hover:text-cyan-400 transition-colors flex items-center gap-2">
        <span class="text-cyan-400" aria-hidden="true">&gt;</span> CarlosBuilds<span class="inline-block w-2 h-4 bg-cyan-400 blink-cursor" aria-hidden="true"></span>
      </a>
      <nav aria-label="Principal" class="flex items-center gap-1 font-mono text-xs">
        <a href="/blog" class="inline-flex items-center min-h-11 px-3 text-slate-300 hover:text-cyan-400 transition-colors">Blog</a>
        <a href="/" class="inline-flex items-center min-h-11 px-3 text-slate-300 hover:text-cyan-400 transition-colors">Inicio</a>
      </nav>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-10">

    <a
      href="/blog"
      class="inline-flex items-center gap-2 min-h-11 sm:min-h-9 px-3 rounded border border-slate-800 bg-[#0b1120] text-slate-300 hover:text-cyan-400 hover:border-cyan-400/50 font-mono text-xs transition-all"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
      Volver al blog
    </a>

    <article class="mt-8">
      <header class="mb-8">
        <span class="inline-block bg-cyan-400/10 text-cyan-400 border border-cyan-400/30 px-2 py-0.5 rounded font-mono text-xs font-semibold">
          {entry.data.category}
        </span>

        <h1 class="mt-4 mb-4 text-3xl sm:text-4xl font-bold text-slate-100 tracking-tight leading-tight">
          {entry.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-slate-400">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></svg>
            <time datetime={String(entry.data.date)}>{fechaLegible(String(entry.data.date))}</time>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            {minutos} min de lectura
          </span>
        </div>

        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-[11px]">
            {entry.data.tags.map((tag) => (
              <span class="bg-slate-900 border border-slate-800 text-slate-400 px-2 py-0.5 rounded">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      {titulos.length >= 3 && (
        <nav aria-labelledby="indice-titulo" class="mb-10 rounded-lg border border-slate-800/80 bg-[#0b1120] p-5">
          <p id="indice-titulo" class="mb-3 flex items-center gap-2 font-mono text-xs text-cyan-400">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
            EN ESTA ENTRADA
          </p>
          <ol class="space-y-1 text-sm">
            {titulos.map((h) => (
              <li class={h.depth === 3 ? 'pl-5' : ''}>
                <a href={`#${h.slug}`} class="inline-block py-1 text-slate-300 hover:text-cyan-400 transition-colors">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="articulo">
        <Content />
      </div>
    </article>

    <!-- ANTERIOR / SIGUIENTE -->
    {(masAntigua || masReciente) && (
      <nav aria-label="Más entradas" class="mt-14 grid gap-4 sm:grid-cols-2">
        {masAntigua && (
          <a href={`/blog/${masAntigua.slug}`} class="group block rounded-lg border border-slate-800 bg-[#0b1120] p-4 hover:border-cyan-400/50 transition-all">
            <span class="mb-1 flex items-center gap-1.5 font-mono text-[11px] text-slate-400">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
              Entrada anterior
            </span>
            <span class="font-semibold text-slate-100 group-hover:text-cyan-400 transition-colors">{masAntigua.data.title}</span>
          </a>
        )}
        {masReciente && (
          <a href={`/blog/${masReciente.slug}`} class:list={['group block rounded-lg border border-slate-800 bg-[#0b1120] p-4 hover:border-cyan-400/50 transition-all sm:text-right', !masAntigua && 'sm:col-start-2']}>
            <span class="mb-1 flex items-center gap-1.5 font-mono text-[11px] text-slate-400 sm:justify-end">
              Entrada siguiente
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </span>
            <span class="font-semibold text-slate-100 group-hover:text-cyan-400 transition-colors">{masReciente.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <!-- RELACIONADAS -->
    {relacionadas.length > 0 && (
      <section aria-labelledby="relacionadas-titulo" class="mt-12">
        <h2 id="relacionadas-titulo" class="mb-4 font-mono text-xs text-cyan-400">// TAMBIÉN TE PUEDE INTERESAR</h2>
        <ul class="space-y-3">
          {relacionadas.map((p) => (
            <li>
              <a href={`/blog/${p.slug}`} class="group block rounded-lg border border-slate-800 bg-[#0b1120] p-4 hover:border-cyan-400/50 transition-all">
                <span class="block font-semibold text-slate-100 group-hover:text-cyan-400 transition-colors">{p.data.title}</span>
                <span class="mt-1 block text-sm text-slate-400">{p.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800/60 mt-20 py-8 text-center font-mono text-xs text-slate-400">
    <nav aria-label="Enlaces del sitio" class="mb-4 flex justify-center gap-6">
      <a href="/" class="hover:text-cyan-400 py-2">Mi página principal</a>
      <a href="/blog" class="hover:text-cyan-400 py-2">Blog</a>
    </nav>
    <p>© 2026 CarlosBuilds · El hombre aprende mientras vive · sin cookies, contador de visitas anónimo</p>
  </footer>

  <script is:inline>
    // --- BARRA DE PROGRESO ---
    var barra = document.getElementById('progreso');

    function actualizarProgreso() {
      var total = document.documentElement.scrollHeight - window.innerHeight;
      var avance = total > 0 ? Math.min(window.scrollY / total, 1) : 0;
      if (barra) barra.style.transform = 'scaleX(' + avance + ')';
    }

    window.addEventListener('scroll', actualizarProgreso, { passive: true });
    window.addEventListener('resize', actualizarProgreso);
    actualizarProgreso();

    // --- BOTÓN "COPIAR" EN LOS BLOQUES DE CÓDIGO ---
    var ICONO_COPIAR =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>';
    var ICONO_LISTO =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>';

    document.querySelectorAll('.articulo pre').forEach(function (pre) {
      var envoltura = document.createElement('div');
      envoltura.className = 'bloque-codigo';
      pre.parentNode.insertBefore(envoltura, pre);
      envoltura.appendChild(pre);

      var boton = document.createElement('button');
      boton.type = 'button';
      boton.className = 'copiar-codigo';
      boton.setAttribute('aria-label', 'Copiar código');
      boton.innerHTML = ICONO_COPIAR + '<span>Copiar</span>';
      envoltura.appendChild(boton);

      boton.addEventListener('click', function () {
        var codigo = pre.querySelector('code') || pre;
        var texto = codigo.innerText;

        navigator.clipboard
          .writeText(texto)
          .then(function () {
            boton.innerHTML = ICONO_LISTO + '<span>Copiado</span>';
            setTimeout(function () {
              boton.innerHTML = ICONO_COPIAR + '<span>Copiar</span>';
            }, 2000);
          })
          .catch(function () {
            boton.innerHTML = '<span>No se pudo copiar</span>';
            setTimeout(function () {
              boton.innerHTML = ICONO_COPIAR + '<span>Copiar</span>';
            }, 2000);
          });
      });
    });
  </script>
</BaseLayout>

<style is:global>
  .articulo {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #cbd5e1;
    overflow-wrap: anywhere;
  }

  .articulo > * + * {
    margin-top: 1.2em;
  }

  .articulo h2 {
    margin-top: 2.2em;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    color: #f1f5f9;
    scroll-margin-top: 80px;
  }

  .articulo h3 {
    margin-top: 1.8em;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: #f1f5f9;
    scroll-margin-top: 80px;
  }

  .articulo a {
    color: #22d3ee;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .articulo ul,
  .articulo ol {
    padding-left: 1.5em;
  }

  .articulo ul {
    list-style: disc;
  }

  .articulo ol {
    list-style: decimal;
  }

  .articulo li + li {
    margin-top: 0.4em;
  }

  .articulo code {
    padding: 0.1em 0.35em;
    border: 1px solid #1e293b;
    border-radius: 4px;
    background: #0b1120;
    font-family: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.88em;
    color: #e2e8f0;
  }

  .bloque-codigo {
    position: relative;
  }

  .articulo pre {
    margin: 0;
    padding: 2.8rem 1rem 1rem;
    overflow-x: auto;
    border: 1px solid #1e293b;
    border-radius: 8px;
    background-color: #0b1120 !important;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .articulo pre code {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
  }

  .copiar-codigo {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 10px;
    border: 1px solid #334155;
    border-radius: 6px;
    background: #0f172a;
    color: #cbd5e1;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .copiar-codigo:hover {
    border-color: #22d3ee;
    color: #22d3ee;
  }

  .articulo blockquote {
    margin-left: 0;
    padding-left: 1rem;
    border-left: 3px solid #22d3ee;
    font-style: italic;
    color: #94a3b8;
  }

  .articulo hr {
    border: 0;
    border-top: 1px solid #1f2937;
  }

  .articulo img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .articulo table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .articulo th,
  .articulo td {
    padding: 0.5rem 0.75rem;
    border: 1px solid #1e293b;
  }
</style>