---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <title>{entry.data.title} — CarlosBuilds</title>
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen font-sans p-6">
    <main class="max-w-3xl mx-auto space-y-6">
      <a href="/" class="text-cyan-400 hover:underline">← Volver al inicio</a>
      <h1 class="text-3xl font-bold text-white">{entry.data.title}</h1>
      <p class="text-gray-400 text-sm">{entry.data.date} • {entry.data.category}</p>
      <hr class="border-gray-800" />
      <article class="prose prose-invert max-w-none">
        <Content />
      </article>
    </main>
  </body>
</html>