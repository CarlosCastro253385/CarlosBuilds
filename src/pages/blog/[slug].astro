---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout
  title={`${entry.data.title} — CarlosBuilds`}
  description={entry.data.summary}
  htmlClass="dark"
  bodyClass="bg-gray-950 text-gray-100 min-h-screen font-sans px-4 py-6 sm:px-6"
  type="article"
>
  <main class="max-w-3xl mx-auto space-y-6">
    <a
      href="/blog"
      class="inline-block text-cyan-400 hover:underline rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
    >
      ← Volver al blog
    </a>
    <h1 class="text-2xl sm:text-3xl font-bold text-white leading-tight">{entry.data.title}</h1>
    <p class="text-gray-400 text-sm">{entry.data.date} • {entry.data.category}</p>
    <hr class="border-gray-800" />
    <article class="articulo">
      <Content />
    </article>
  </main>
</BaseLayout>

<style is:global>
  .articulo {
    color: #cbd5e1;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .articulo > * + * {
    margin-top: 1.1em;
  }
  .articulo h2 {
    color: #f1f5f9;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2em;
    line-height: 1.3;
  }
  .articulo h3 {
    color: #f1f5f9;
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 1.6em;
    line-height: 1.3;
  }
  .articulo a {
    color: #22d3ee;
    text-decoration: underline;
  }
  .articulo a:focus-visible {
    outline: 2px solid #22d3ee;
    outline-offset: 2px;
    border-radius: 2px;
  }
  .articulo ul,
  .articulo ol {
    padding-left: 1.4em;
  }
  .articulo ul {
    list-style: disc;
  }
  .articulo ol {
    list-style: decimal;
  }
  .articulo li + li {
    margin-top: 0.35em;
  }
  .articulo code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.9em;
    background: #0b1120;
    border: 1px solid #1e293b;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    color: #e2e8f0;
  }
  .articulo pre {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid #1e293b;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .articulo pre code {
    background: none;
    border: 0;
    padding: 0;
  }
  .articulo blockquote {
    border-left: 3px solid #22d3ee;
    padding-left: 1rem;
    color: #94a3b8;
    font-style: italic;
  }
  .articulo img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .articulo table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .articulo th,
  .articulo td {
    border: 1px solid #1e293b;
    padding: 0.5rem 0.75rem;
  }
</style>