---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

// Obtener todos los posts desde src/content/blog/
const posts = await getCollection('blog');

// Datos editables desde el panel (con valores de respaldo por si falta alguno)
const ajustes = await getEntry('ajustes', 'blog');
const landing = await getEntry('landing', 'index');

const sobreMiTexto =
  ajustes?.data.sobre_mi_texto ??
  'Hola, soy Carlos. Construyo proyectos web y de backend para entender cosas grandes. Todo lo que aprendo y resuelvo, lo escribo aquí.';
const contactEmail = landing?.data.contacto_email ?? 'cruzcastro4@gmail.com';
const githubUrl = landing?.data.github_url ?? 'https://github.com/CarlosCastro253385/';
const instagramUrl = landing?.data.instagram_url ?? 'https://www.instagram.com/slrc_ttr/';

// Calcular estadísticas reales iniciales
const totalPosts = posts.length;
const miniProjectsCount = posts.filter(p => p.data.category === 'MINI-PROYECTO').length;
const problemsSolvedCount = posts.filter(p => p.data.category === 'PROBLEMA-RESUELTO').length;

// Extraer todos los tags únicos de la lista de posts
const allTags = Array.from(
  new Set(posts.flatMap(post => post.data.tags || []))
);

// Texto en minúsculas y sin acentos, para que la búsqueda los ignore
const normalizar = (texto: string) =>
  texto.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

const textoBuscable = (post: (typeof posts)[number]) =>
  normalizar(
    [post.data.title, post.data.summary, post.data.category, ...(post.data.tags || [])].join(' ')
  );
---

<BaseLayout
  title="CarlosBuilds — Mini proyectos y problemas reales"
  description="Escribo sobre lo que construyo y lo que rompo: backend, herramientas de línea de comandos, bases de datos y los errores que nadie documenta bien."
  htmlClass="dark"
  bodyClass="font-sans text-slate-400 min-h-screen antialiased selection:bg-cyan-400 selection:text-black"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />
  </Fragment>

  <!-- ENCABEZADO -->
  <header class="border-b border-slate-800/60 bg-[#050810]/80 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between text-sm">
      <a href="/" class="font-mono text-slate-100 hover:text-cyan-400 transition-colors flex items-center gap-2">
        <span class="text-cyan-400" aria-hidden="true">&gt;</span> CarlosBuilds<span class="inline-block w-2 h-4 bg-cyan-400 blink-cursor" aria-hidden="true"></span>
      </a>

      <div class="flex items-center gap-3 font-mono text-xs">
        <!-- BOTÓN COPIAR EMAIL -->
        <button 
          id="copy-email-btn"
          data-email={contactEmail}
          class="flex items-center gap-2 min-h-11 sm:min-h-9 bg-[#0b1120] text-slate-300 hover:text-cyan-400 border border-slate-800 hover:border-cyan-400/50 px-3 rounded transition-all cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span id="email-btn-text" aria-live="polite">Copiar Email</span>
        </button>

        <div class="hidden sm:flex items-center gap-2 text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-2.5 py-1 rounded-full">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
          Disponible
        </div>
      </div>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="max-w-6xl mx-auto px-4 py-12">

    <!-- HERO SECTION -->
    <section class="mb-12">
      <a
        href="/"
        class="inline-flex items-center gap-2 min-h-11 sm:min-h-9 mb-6 px-3 rounded border border-slate-800 bg-[#0b1120] text-slate-300 hover:text-cyan-400 hover:border-cyan-400/50 font-mono text-xs transition-all"
      >
        <span aria-hidden="true">←</span> Mi página principal
      </a>

      <div class="font-mono text-xs text-cyan-400 mb-3 flex items-center gap-2">
        <span>~ / CarlosBuilds / blog</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-bold text-slate-100 tracking-tight mb-4 max-w-2xl leading-tight">
        Mini proyectos, <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">problemas reales</span> y lo que aprendí.
      </h1>

      <p class="text-slate-400 max-w-2xl text-base mb-6 leading-relaxed">
        Escribo sobre lo que construyo y lo que rompo. Backend, herramientas de línea de comandos, bases de datos y los errores que nadie documenta bien.
      </p>

      <div class="font-mono text-xs text-slate-400 flex items-center gap-4">
        <span><strong class="text-slate-100" id="counter-total">{totalPosts}</strong> posts publicados</span>
      </div>
    </section>

    <!-- GRID PRINCIPAL -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

      <!-- COLUMNA IZQUIERDA: BUSCADOR + FILTROS + LISTA DE ARTÍCULOS -->
      <div class="lg:col-span-8">

        <!-- BUSCADOR -->
        <div class="mb-4">
          <label for="search-input" class="sr-only">Buscar en el blog</label>
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
            </svg>
            <input
              id="search-input"
              type="search"
              autocomplete="off"
              placeholder="Buscar por título, resumen o etiqueta…"
              class="w-full min-h-11 bg-[#0b1120] text-slate-100 placeholder:text-slate-400 border border-slate-800 hover:border-slate-600 focus:border-cyan-400 rounded pl-10 pr-3 font-mono text-base sm:text-sm transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            />
          </div>
          <p id="search-status" class="sr-only" role="status"></p>
        </div>

        <!-- BOTONES DE FILTRO DE CATEGORÍA -->
        <div class="flex flex-wrap gap-2 mb-6 font-mono text-xs" id="category-filters">
          <button data-filter="TODOS" aria-pressed="true" class="cat-btn active bg-cyan-400 text-black font-bold px-3 min-h-11 sm:min-h-9 inline-flex items-center rounded transition-all">
            TODOS
          </button>
          <button data-filter="MINI-PROYECTO" aria-pressed="false" class="cat-btn bg-[#0b1120] text-slate-400 border border-slate-800 hover:border-slate-600 px-3 min-h-11 sm:min-h-9 inline-flex items-center rounded transition-all">
            MINI-PROYECTO
          </button>
          <button data-filter="PROBLEMA-RESUELTO" aria-pressed="false" class="cat-btn bg-[#0b1120] text-slate-400 border border-slate-800 hover:border-slate-600 px-3 min-h-11 sm:min-h-9 inline-flex items-center rounded transition-all">
            PROBLEMA-RESUELTO
          </button>
        </div>

        <!-- CONTENEDOR DE POSTS -->
        <div class="space-y-4" id="posts-container">
          {posts.map((post) => (
            <article 
              class="post-card bg-[#0b1120] border border-slate-800/80 hover:border-cyan-400/50 rounded-lg p-5 sm:p-6 transition-all duration-200 group"
              data-category={post.data.category}
              data-tags={JSON.stringify(post.data.tags || [])}
              data-search={textoBuscable(post)}
            >
              <div class="flex justify-between items-center font-mono text-xs mb-3">
                <span class="bg-cyan-400/10 text-cyan-400 border border-cyan-400/30 px-2 py-0.5 rounded font-semibold">
                  {post.data.category}
                </span>
              </div>

              <h2 class="text-lg font-bold text-slate-100 group-hover:text-cyan-400 transition-colors mb-2">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h2>

              <p class="text-sm text-slate-400 leading-relaxed mb-4">
                {post.data.summary}
              </p>

              <div class="flex flex-wrap justify-between items-center font-mono text-[11px] text-slate-400 pt-3 border-t border-slate-800/40 gap-2">
                <div class="flex gap-1.5 flex-wrap">
                  {post.data.tags?.map((tag) => (
                    <span class="bg-slate-900 border border-slate-800 text-slate-400 px-2 py-0.5 rounded">
                      #{tag}
                    </span>
                  ))}
                </div>
                <div class="flex items-center gap-3">
                  <span>{post.data.date}</span>
                  <a href={`/blog/${post.slug}`} class="text-cyan-400 hover:underline py-2">Leer artículo →</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div id="no-results" class="hidden text-center py-12 px-4 border border-dashed border-slate-800 rounded-lg font-mono text-xs text-slate-400">
          <p class="mb-4">No se encontraron artículos con estos filtros.</p>
          <button
            id="clear-filters-btn"
            type="button"
            class="inline-flex items-center min-h-11 sm:min-h-9 px-4 rounded border border-slate-700 bg-[#0b1120] text-cyan-400 hover:border-cyan-400/50 transition-all cursor-pointer"
          >
            Limpiar filtros
          </button>
        </div>

      </div>

      <!-- COLUMNA DERECHA: SIDEBAR -->
      <aside class="lg:col-span-4 space-y-6">

        <!-- SOBRE MÍ (editable desde el panel) -->
        <div class="bg-[#0b1120] border border-slate-800/80 rounded-lg p-5">
          <div class="font-mono text-xs text-cyan-400 mb-2">// SOBRE MI</div>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            {sobreMiTexto}
          </p>
          <div class="font-mono text-xs flex flex-wrap gap-x-4 gap-y-1 text-cyan-400">
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline py-2">GitHub</a>
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:underline py-2">Instagram</a>
            <button class="copy-email-link hover:underline text-left cursor-pointer py-2" data-email={contactEmail}>Contacto</button>
          </div>
        </div>

        <!-- TAGS INTERACTIVOS -->
        {allTags.length > 0 && (
          <div class="bg-[#0b1120] border border-slate-800/80 rounded-lg p-5">
            <div class="font-mono text-xs text-cyan-400 mb-3">// TAGS</div>
            <div class="flex flex-wrap gap-1.5 font-mono text-[11px]" id="tags-container">
              {allTags.map((tag) => (
                <button 
                  data-tag={tag}
                  aria-pressed="false"
                  class="tag-btn bg-slate-900 border border-slate-800 text-slate-400 hover:border-slate-600 px-2 min-h-10 sm:min-h-8 inline-flex items-center rounded transition-all"
                >
                  #{tag}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- STATS AUTOMÁTICAS -->
        <div class="bg-[#0b1120] border border-slate-800/80 rounded-lg p-5 font-mono text-xs space-y-2">
          <div class="text-cyan-400 mb-3">// STATS</div>
          <div class="flex justify-between text-slate-400">
            <span>total posts</span>
            <span class="text-cyan-400 font-bold">{totalPosts}</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>mini-proyectos</span>
            <span class="text-cyan-400 font-bold">{miniProjectsCount}</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>problemas resueltos</span>
            <span class="text-cyan-400 font-bold">{problemsSolvedCount}</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>tags distintos</span>
            <span class="text-cyan-400 font-bold">{allTags.length}</span>
          </div>
        </div>

      </aside>

    </div>
    
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800/60 mt-20 py-8 text-center font-mono text-xs text-slate-400">
    <nav aria-label="Enlaces del sitio" class="mb-4 flex justify-center gap-6">
      <a href="/" class="hover:text-cyan-400 py-2">Mi página principal</a>
      <a href="/blog" class="hover:text-cyan-400 py-2">Blog</a>
    </nav>
    <p>© 2026 CarlosBuilds · El hombre aprende mientras vive · sin cookies, sin trackers</p>
  </footer>

  <!-- SCRIPTS CLIENT SIDE -->
  <script is:inline>
    // --- CLASES DE LOS BOTONES (activo / inactivo) ---
    const CAT_ON = "cat-btn active bg-cyan-400 text-black font-bold px-3 min-h-11 sm:min-h-9 inline-flex items-center rounded transition-all";
    const CAT_OFF = "cat-btn bg-[#0b1120] text-slate-400 border border-slate-800 hover:border-slate-600 px-3 min-h-11 sm:min-h-9 inline-flex items-center rounded transition-all";
    const TAG_ON = "tag-btn bg-cyan-400 text-black font-bold border border-cyan-400 px-2 min-h-10 sm:min-h-8 inline-flex items-center rounded transition-all";
    const TAG_OFF = "tag-btn bg-slate-900 border border-slate-800 text-slate-400 hover:border-slate-600 px-2 min-h-10 sm:min-h-8 inline-flex items-center rounded transition-all";

    // --- LÓGICA DE COPIAR CORREO ---
    const copyBtn = document.getElementById('copy-email-btn');
    const btnText = document.getElementById('email-btn-text');
    const emailLinks = document.querySelectorAll('.copy-email-link');

    function copyToClipboard(email) {
      navigator.clipboard.writeText(email).then(() => {
        if (btnText) {
          const originalText = btnText.innerText;
          btnText.innerText = '✓ ¡Copiado!';
          setTimeout(() => {
            btnText.innerText = originalText;
          }, 2000);
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const email = copyBtn.dataset.email;
        copyToClipboard(email);
      });
    }

    emailLinks.forEach(link => {
      link.addEventListener('click', () => {
        const email = link.dataset.email;
        copyToClipboard(email);
      });
    });

    // --- LÓGICA DE BÚSQUEDA Y FILTRADO DE POSTS ---
    let activeCategory = 'TODOS';
    let activeTag = null;
    let query = '';

    const cards = document.querySelectorAll('.post-card');
    const noResults = document.getElementById('no-results');
    const catBtns = document.querySelectorAll('.cat-btn');
    const tagBtns = document.querySelectorAll('.tag-btn');
    const counterTotal = document.getElementById('counter-total');
    const searchInput = document.getElementById('search-input');
    const searchStatus = document.getElementById('search-status');
    const clearBtn = document.getElementById('clear-filters-btn');

    // Minúsculas y sin acentos, igual que en el servidor
    function normalizar(texto) {
      return (texto || '')
        .toString()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    // Guarda la búsqueda en la dirección (?q=...) sin recargar la página
    function syncUrl() {
      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set('q', query);
      } else {
        url.searchParams.delete('q');
      }
      window.history.replaceState({}, '', url);
    }

    function applyFilters() {
      let visibleCount = 0;
      const terms = normalizar(query).split(/\s+/).filter(Boolean);

      cards.forEach(card => {
        const category = card.dataset.category;
        const tags = JSON.parse(card.dataset.tags || '[]');
        const haystack = card.dataset.search || '';

        const matchCategory = activeCategory === 'TODOS' || category === activeCategory;
        const matchTag = activeTag === null || tags.includes(activeTag);
        const matchText = terms.every(term => haystack.includes(term));

        if (matchCategory && matchTag && matchText) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (counterTotal) {
        counterTotal.innerText = visibleCount.toString();
      }

      if (searchStatus) {
        searchStatus.textContent =
          visibleCount === 1 ? '1 resultado' : visibleCount + ' resultados';
      }

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    function limpiarFiltros() {
      activeCategory = 'TODOS';
      activeTag = null;
      query = '';
      if (searchInput) searchInput.value = '';

      catBtns.forEach(b => {
        const activo = b.dataset.filter === 'TODOS';
        b.className = activo ? CAT_ON : CAT_OFF;
        b.setAttribute('aria-pressed', activo ? 'true' : 'false');
      });
      tagBtns.forEach(b => {
        b.className = TAG_OFF;
        b.setAttribute('aria-pressed', 'false');
      });

      syncUrl();
      applyFilters();
    }

    // Buscador
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        query = searchInput.value.trim();
        syncUrl();
        applyFilters();
      });
    }

    // Botón "Limpiar filtros"
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        limpiarFiltros();
        if (searchInput) searchInput.focus();
      });
    }

    // Eventos de botones de categoría
    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.className = CAT_OFF;
          b.setAttribute('aria-pressed', 'false');
        });
        btn.className = CAT_ON;
        btn.setAttribute('aria-pressed', 'true');

        activeCategory = btn.dataset.filter || 'TODOS';
        applyFilters();
      });
    });

    // Eventos de botones de tags
    tagBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag || null;

        tagBtns.forEach(b => {
          b.className = TAG_OFF;
          b.setAttribute('aria-pressed', 'false');
        });

        if (activeTag === tag) {
          activeTag = null;
        } else {
          btn.className = TAG_ON;
          btn.setAttribute('aria-pressed', 'true');
          activeTag = tag;
        }

        applyFilters();
      });
    });

    // Si llegas con ?q=algo en la dirección, la búsqueda ya viene aplicada
    const inicial = new URLSearchParams(window.location.search).get('q');
    if (inicial && searchInput) {
      query = inicial.trim();
      searchInput.value = query;
      applyFilters();
    }
  </script>
</BaseLayout>

<style is:global>
  body {
    background-color: #050810;
    background-image: 
      radial-gradient(circle at 50% 0%, rgba(0, 242, 254, 0.08) 0%, transparent 60%),
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 100% 100%, 32px 32px, 32px 32px;
  }

  .blink-cursor {
    animation: blink 1s step-start infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
</style>